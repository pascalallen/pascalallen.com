{
  "name": "pascalallen.com",
  "version": "2.0.0",
  "description": "Terminal host for pascalallen.com.",
  "repository": "https://github.com/pascalallen/pascalallen.com",
  "author": "Pascal Allen",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "webpack --config webpack.config.js --mode production && node budget.mjs",
    "ci": "yarn install --frozen-lockfile",
    "dev": "webpack --config webpack.config.js --mode development",
    "watch": "webpack --config webpack.config.js --mode development --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test \".test-build/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jsdom": "^26.1.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.10.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1"
  }
}
