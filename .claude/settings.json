{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go list *)",
      "Bash(go mod verify)",
      "Bash(go mod download)",
      "Bash(go generate ./...)",
      "Bash(go run github.com/google/wire/cmd/wire ./cmd/*)",
      "Bash(go run golang.org/x/vuln/cmd/govulncheck@latest *)",
      "Bash(gofmt *)",
      "Bash(bin/verify)",
      "Bash(bin/vulncheck *)",
      "Bash(bin/up)",
      "Bash(bin/down)",
      "Bash(bin/wasm)",
      "Bash(bin/exec go test *)",
      "Bash(bin/exec go build *)",
      "Bash(bin/exec go vet *)",
      "Bash(bin/exec gofmt *)",
      "Bash(bin/yarn lint)",
      "Bash(bin/yarn build)",
      "Bash(bin/yarn ci)",
      "Bash(yarn lint)",
      "Bash(yarn build)",
      "Bash(yarn install --frozen-lockfile)",
      "Bash(yarn test *)",
      "Bash(docker info *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch --list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Edit(**/wire_gen.go)",
      "Bash(docker compose config*)",
      "Bash(bin/exec env*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.go) gofmt -w \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "gofmt"
          }
        ]
      }
    ]
  }
}
