APP_ENV=local
APP_BASE_URL=http://localhost:9990
PORT=9990

# debug || test || release
GIN_MODE=debug

# server-side only, never sent to the browser
GITHUB_TOKEN=

# server-side only, never sent to the browser
SLACK_DM_URL=

# feed upstream overrides for tests; empty uses the public GitHub and npm APIs
# GITHUB_TOKEN is sent to whatever host GITHUB_REPOS_URL names, so leave GITHUB_REPOS_URL unset outside tests
GITHUB_REPOS_URL=
NPM_SEARCH_URL=

# comma-separated CIDRs or IPs of reverse proxies whose X-Forwarded-For is trusted; empty trusts none
TRUSTED_PROXIES=
