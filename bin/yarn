#!/usr/bin/env bash

# change to the project root
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR"/.. || exit

TTY_FLAGS="-i"
if [ -t 0 ] && [ -t 1 ]; then
    TTY_FLAGS="-it"
fi

case "$1" in
    "serve")
    docker container run \
        -p 127.0.0.1:8181:8181/tcp \
        --rm $TTY_FLAGS --user "$(id -u):$(id -g)" -e HOME=/tmp \
        -v "$(pwd)":/app \
        -w /app/web/app \
        node:22 yarn "$@"
    ;;
    *)
    docker container run \
        --rm $TTY_FLAGS --user "$(id -u):$(id -g)" -e HOME=/tmp \
        -v "$(pwd)":/app \
        -w /app/web/app \
        node:22 yarn "$@"
    ;;
esac
