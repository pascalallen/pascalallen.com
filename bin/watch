#!/usr/bin/env bash

# change to the project root
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR"/.. || exit

docker container run \
    --rm -it \
    -v "$(pwd)":/app \
    -w /app \
    -p 9990:9990 \
    --name pascalallen-air \
    --env-file .env \
    -e PORT=9990 \
    cosmtrek/air \
    -build.exclude_dir "web"
