#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR"/.. || exit 1

GO_IMAGE="golang:1.26.11"
NODE_IMAGE="node:22"
CACHE="${VERIFY_CACHE:-$HOME/.cache/pascalallen-verify}"
mkdir -p "$CACHE/go" "$CACHE/gocache" "$CACHE/yarn"

step() {
    printf '\n==> %s\n' "$1"
}

run_go() {
    docker run --rm \
        --user "$(id -u):$(id -g)" \
        -e HOME=/tmp \
        -e GOPATH=/cache/go \
        -e GOCACHE=/cache/gocache \
        -e GOFLAGS=-buildvcs=false \
        -v "$CACHE/go":/cache/go \
        -v "$CACHE/gocache":/cache/gocache \
        -v "$PWD":/app \
        -w /app \
        "$GO_IMAGE" "$@"
}

run_node() {
    docker run --rm \
        --user "$(id -u):$(id -g)" \
        -e HOME=/tmp \
        -e YARN_CACHE_FOLDER=/cache/yarn \
        -v "$CACHE/yarn":/cache/yarn \
        -v "$PWD":/app \
        -w /app/web/app \
        "$NODE_IMAGE" "$@"
}

step "go mod verify"
run_go go mod verify

step "go build ./..."
run_go go build ./...

step "gofmt -l"
unformatted="$(run_go gofmt -l cmd internal)"
if [ -n "$unformatted" ]; then
    printf '%s\n' "$unformatted"
    exit 1
fi

step "go vet ./..."
run_go go vet ./...

step "go test -race -cover ./..."
run_go go test -race -cover ./...

step "wire drift"
if [ -f internal/pascalallen/infrastructure/container/wire.go ]; then
    run_go go generate ./...
else
    run_go go run github.com/google/wire/cmd/wire ./cmd/pascalallen
fi
if [ -n "$(git status --porcelain)" ]; then
    git status --porcelain
    git diff
    exit 1
fi

step "govulncheck ./..."
set +e
vuln_out="$(run_go sh -c "go install golang.org/x/vuln/cmd/govulncheck@latest && /cache/go/bin/govulncheck ./..." 2>&1)"
vuln_code=$?
set -e
printf '%s\n' "$vuln_out" | bin/vulncheck "$vuln_code"

step "yarn install --frozen-lockfile"
run_node yarn install --frozen-lockfile

step "yarn lint"
run_node yarn lint

step "yarn build"
run_node yarn build

printf '\nverify: all steps passed\n'
