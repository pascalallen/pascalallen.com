#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR"/.. || exit 1

GO_IMAGE="golang:1.26.11"
NODE_IMAGE="node:22"
CACHE="${VERIFY_CACHE:-$HOME/.cache/pascalallen-verify}"
mkdir -p "$CACHE/go" "$CACHE/gocache" "$CACHE/yarn"

step() {
    printf '\n==> %s\n' "$1"
}

run_go() {
    docker run --rm \
        --user "$(id -u):$(id -g)" \
        -e HOME=/tmp \
        -e GOPATH=/cache/go \
        -e GOCACHE=/cache/gocache \
        -e GOFLAGS=-buildvcs=false \
        -v "$CACHE/go":/cache/go \
        -v "$CACHE/gocache":/cache/gocache \
        -v "$PWD":/app \
        -w /app \
        "$GO_IMAGE" "$@"
}

run_node() {
    docker run --rm \
        --user "$(id -u):$(id -g)" \
        -e HOME=/tmp \
        -e YARN_CACHE_FOLDER=/cache/yarn \
        -v "$CACHE/yarn":/cache/yarn \
        -v "$PWD":/app \
        -w /app/web/app \
        "$NODE_IMAGE" "$@"
}

step "go mod verify"
run_go go mod verify

step "go build ./..."
run_go go build ./...

step "gofmt -l"
unformatted="$(run_go gofmt -l cmd internal)"
if [ -n "$unformatted" ]; then
    printf '%s\n' "$unformatted"
    exit 1
fi

step "go vet ./..."
run_go go vet ./...

step "go test -race -cover ./..."
run_go go test -race -cover ./...

step "go mod tidy drift"
tidy_before="$(cat go.mod go.sum)"
run_go go mod tidy
if [ "$tidy_before" != "$(cat go.mod go.sum)" ]; then
    git diff go.mod go.sum
    exit 1
fi

step "wire drift"
run_go go generate ./...
if [ -n "$(git status --porcelain)" ]; then
    git status --porcelain
    git diff
    exit 1
fi

step "govulncheck ./..."
set +e
vuln_out="$(run_go sh -c "go install golang.org/x/vuln/cmd/govulncheck@latest && /cache/go/bin/govulncheck ./..." 2>&1)"
vuln_code=$?
set -e
printf '%s\n' "$vuln_out" | bin/vulncheck "$vuln_code"

step "yarn install --frozen-lockfile"
run_node yarn install --frozen-lockfile

step "yarn lint"
run_node yarn lint

step "yarn test"
run_node yarn test

step "yarn build"
run_node yarn build

step "bin/wasm"
bin/wasm

step "bin/wasm-size"
bin/wasm-size

step "bin/wasm-smoke"
bin/wasm-smoke

step "bin/wasm-parity"
bin/wasm-parity

step "bin/e2e"
E2E_PREBUILT=1 bin/e2e

step "shellcheck bin/* scripts/*"
if command -v shellcheck >/dev/null 2>&1; then
    shellcheck bin/* scripts/*
else
    docker run --rm -v "$PWD":/mnt -w /mnt koalaman/shellcheck:stable bin/* scripts/*
fi

step "scripts/cron-deploy.test.sh"
scripts/cron-deploy.test.sh

printf '\nverify: all steps passed\n'
